{
  "name": "paperminer",
  "type": "module",
  "version": "0.1.6",
  "description": "PaperMiner: AI reading assistant for Zotero with journal ranking, chat, summary, slides and translation.",
  "config": {
    "addonName": "PaperMiner",
    "addonID": "paperminer@paperminer.org",
    "addonRef": "paperminer",
    "addonInstance": "PaperMiner",
    "prefsPrefix": "extensions.zotero.paperminer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Waynehfut/Paper-Miner.git"
  },
  "author": "PaperMiner contributors",
  "bugs": {
    "url": "https://github.com/Waynehfut/Paper-Miner/issues"
  },
  "homepage": "https://github.com/Waynehfut/Paper-Miner",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13",
    "pptxgenjs": "4.0.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4",
    "@types/markdown-it": "^14.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
